# Configuración del Worker GPU en Google Colab
# URL pública expuesta vía Cloudflare Tunnel o ngrok (ej. https://xxxx.trycloudflare.com o https://xxxx.ngrok-free.app)
COLAB_TTS_URL=https://your-colab-tunnel.trycloudflare.com

# Token de autenticación Bearer configurado en el worker de Colab
COLAB_API_TOKEN=camila-gpu-2026

# Timeout estricto para peticiones HTTP al worker en Colab (en segundos)
COLAB_TIMEOUT_SECONDS=6.5

# Alta Disponibilidad / Fallback local (Edge-TTS Colombia Salomé)
FALLBACK_TTS_ENABLED=true
FALLBACK_VOICE=es-CO-SalomeNeural

# Directorio para almacenar audios generados localmente (opcional)
AUDIO_OUTPUT_DIR=./audio_output
